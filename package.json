{
  "name": "telemetry-monitor",
  "version": "1.0.0",
  "description": "Real-time telemetry monitoring desktop app (Angular + Electron)",
  "main": "electron/main.js",
  "scripts": {
    "test": "npm test --prefix frontend -- --watch=false",
    "frontend": "npm start --prefix frontend -- --host 127.0.0.1",
    "electron": "wait-on tcp:127.0.0.1:4200 tcp:127.0.0.1:3000 && electron .",
    "dev": "concurrently \"npm:backend\" \"npm:frontend\" \"npm:electron\"",
    "backend": "tsx watch backend/src/server.ts",
    "backend:build": "tsc -p backend/tsconfig.json"
  },
  "keywords": [],
  "author": "Shreya Adgaonkar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@primeuix/themes": "^3.1.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ng2-charts": "^11.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.3"
  }
}
